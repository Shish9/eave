<Window x:Class="ClaudeIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeIsland"
        Title="Eave" Width="600" SizeToContent="Height" Background="{x:Null}"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="FgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Fg2Brush" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="Fg3Brush" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="BtnBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="BtnFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2E86FF"/>

        <Style x:Key="Pillbtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BtnFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Pillbtn}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,40"
          MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" MouseWheel="Root_MouseWheel">
        <local:NotchShape x:Name="Notch" Fill="{DynamicResource BgBrush}" BodyWidth="190" BodyHeight="38"
                          HorizontalAlignment="Center" VerticalAlignment="Top">
            <local:NotchShape.Effect>
                <DropShadowEffect x:Name="GlowFx" ShadowDepth="0" BlurRadius="40" Color="#4F6FA8" Opacity="0"/>
            </local:NotchShape.Effect>
        </local:NotchShape>

        <Border x:Name="Host" Width="190" Height="38" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">
            <StackPanel x:Name="Body" Margin="14,6,14,0" TextElement.Foreground="{DynamicResource FgBrush}"
                        TextElement.FontFamily="Segoe UI Variable, Segoe UI" TextElement.FontSize="13">
                <!-- header -->
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#777777" HorizontalAlignment="Left" Margin="0,0,5,0"/>
                        <TextBlock x:Name="DlIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#54A0FF"
                                   Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border x:Name="ArtMini" Width="22" Height="22" CornerRadius="7" Background="{DynamicResource TrackBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="HeaderTitle" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderMeta" Grid.Column="2" Foreground="{DynamicResource Fg3Brush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Symbol"/>
                    <StackPanel x:Name="Wave" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Height="20"
                                Margin="10,0,0,0" Visibility="Collapsed"/>
                </Grid>

                <!-- thin progress bar under the header (volume / timer) -->
                <Grid x:Name="HeaderBar" Height="3" Margin="0,6,0,1" Visibility="Collapsed">
                    <Border Background="{DynamicResource TrackBrush}" CornerRadius="1.5"/>
                    <Border x:Name="HeaderFill" Background="{DynamicResource FgBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="HeaderScale" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                </Grid>

                <StackPanel x:Name="Expanded" Visibility="Collapsed">
                    <!-- permission card -->
                    <StackPanel x:Name="PermPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="PermTool" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PermDetail" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Fg2Brush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PermDiff" FontFamily="Consolas" FontSize="11.5" Margin="0,8,0,0"
                                   TextWrapping="NoWrap" MaxHeight="110" Visibility="Collapsed"/>
                        <Grid Margin="0,12,0,2">
                            <TextBlock x:Name="PermMore" Foreground="{DynamicResource Fg3Brush}" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Deny" Style="{StaticResource Pillbtn}" Click="Deny_Click"/>
                                <Button Content="Always allow" Style="{StaticResource Pillbtn}" Click="Always_Click"/>
                                <Button Content="Allow" Background="{DynamicResource AccentBrush}" Foreground="White" Style="{StaticResource Pillbtn}" Click="Allow_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- sessions -->
                    <ItemsControl x:Name="SessionList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0" Cursor="Hand" Background="#01000000" MouseLeftButtonUp="Row_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" CornerRadius="1.5" Background="{Binding Accent}" Margin="0,1,9,1"/>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Project}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Line}" Foreground="{DynamicResource Fg3Brush}" FontSize="11" MaxHeight="32"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Meta}" Foreground="{DynamicResource Fg3Brush}" FontSize="11" Margin="8,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- now playing -->
                    <Grid x:Name="MediaPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Art" Width="46" Height="46" CornerRadius="12" Background="{DynamicResource TrackBrush}" Margin="0,0,10,0"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                            <TextBlock Text="&#x266B;" FontSize="20" Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MediaArtist" FontSize="11" Foreground="{DynamicResource Fg3Brush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE892;" Style="{StaticResource IconBtn}" Click="Prev_Click"/>
                            <Button x:Name="PlayBtn" Content="&#xE768;" Style="{StaticResource IconBtn}" Click="PlayPause_Click"/>
                            <Button Content="&#xE893;" Style="{StaticResource IconBtn}" Click="Next_Click"/>
                        </StackPanel>
                        <Grid x:Name="MediaBar" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Margin="0,10,0,0">
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="1.5"/>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="MediaScale" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- calendar -->
                    <TextBlock x:Name="CalendarText" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Fg2Brush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

                    <!-- downloads -->
                    <StackPanel x:Name="DownloadPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Downloads" Foreground="{DynamicResource Fg3Brush}" FontSize="11"/>
                        <ItemsControl x:Name="DownloadList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,0,0" Cursor="Hand" Background="#01000000" MouseLeftButtonUp="Download_Click"
                                          ToolTip="Show in folder">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding GlyphBrush}"
                                                   FontSize="12" Margin="0,2,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Fg3Brush}" FontSize="11" Margin="8,1,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- weather -->
                    <TextBlock x:Name="WeatherText" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Fg2Brush}"
                               FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Symbol" Visibility="Collapsed"/>

                    <!-- clipboard history -->
                    <StackPanel x:Name="ClipPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Clipboard" Foreground="{DynamicResource Fg3Brush}" FontSize="11"/>
                        <ItemsControl x:Name="ClipList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" Background="#01000000" Padding="0,3" MouseLeftButtonUp="Clip_Click"
                                            ToolTip="Click to copy again">
                                        <TextBlock Text="{Binding Preview}" FontSize="11.5" Foreground="{DynamicResource Fg2Brush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- quick launch -->
                    <ItemsControl x:Name="QuickList" Margin="0,10,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconBtn}" Margin="0,0,4,0" Padding="7" ToolTip="{Binding Name}" Click="Quick_Click">
                                    <Image Source="{Binding Icon}" Width="20" Height="20"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- timer -->
                    <StackPanel x:Name="TimerPanel" Orientation="Horizontal" Margin="0,12,0,2">
                        <TextBlock Text="Timer" Foreground="{DynamicResource Fg3Brush}" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="5m" Tag="5" Style="{StaticResource Pillbtn}" Click="Timer_Click"/>
                        <Button Content="10m" Tag="10" Style="{StaticResource Pillbtn}" Click="Timer_Click"/>
                        <Button Content="25m" Tag="25" Style="{StaticResource Pillbtn}" Click="Timer_Click"/>
                        <Button x:Name="TimerCancel" Content="Cancel" Visibility="Collapsed" Style="{StaticResource Pillbtn}" Click="TimerCancel_Click"/>
                    </StackPanel>

                    <!-- system stats -->
                    <TextBlock x:Name="StatsText" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource Fg3Brush}"/>
                </StackPanel>

                <!-- pull handle: click to pin open / collapse -->
                <Border x:Name="HandleHit" Height="14" Background="#01000000" Cursor="Hand" MouseLeftButtonUp="Handle_Click"
                        ToolTip="Pin open / collapse">
                    <Border x:Name="HandleLine" Width="36" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
