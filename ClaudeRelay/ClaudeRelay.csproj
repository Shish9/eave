<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>relay</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ApplicationIcon>..\ClaudeIsland\eave.ico</ApplicationIcon>

    <Product>Eave</Product>
    <AssemblyTitle>Eave hook relay</AssemblyTitle>
    <Description>Forwards Claude Code hook events to Eave</Description>
    <Company>Eave contributors</Company>
    <Copyright>Copyright (c) 2026 Eave contributors</Copyright>
    <Version>0.3.1</Version>
  </PropertyGroup>
</Project>
