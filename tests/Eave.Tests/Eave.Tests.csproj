<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the parts of Eave that don't need a window: settings and the Claude Code hook installer.
       They compile the real source files, and run against temporary folders (see Sandbox.cs), never your profile.
       Run:  dotnet test tests/Eave.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Eave.Tests</RootNamespace>
    <!-- the linked source files call Windows-only APIs (registry, shortcuts); the tests never reach those -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\ClaudeIsland\Brand.cs" Link="Eave\Brand.cs" />
    <Compile Include="..\..\ClaudeIsland\Diag.cs" Link="Eave\Diag.cs" />
    <Compile Include="..\..\ClaudeIsland\Settings.cs" Link="Eave\Settings.cs" />
    <Compile Include="..\..\ClaudeIsland\HookInstaller.cs" Link="Eave\HookInstaller.cs" />
    <Compile Include="..\..\ClaudeIsland\Registration.cs" Link="Eave\Registration.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
